<mxfile host="Electron" type="device">
  <diagram id="beam-learning" name="Beam 本地学习系统">
    <mxGraphModel dx="1700" dy="1580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1580" background="#ffffff" adaptiveColors="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Beam 本地学习系统" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=34;fontStyle=1;fontColor=#17212B;" vertex="1" parent="1"><mxGeometry x="60" y="32" width="1140" height="60" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="即时个人词库 + 反馈排序 + 周期 LoRA · 当前 QVAC Vulkan 实现" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#546371;" vertex="1" parent="1"><mxGeometry x="60" y="97" width="1440" height="36" as="geometry"/></mxCell>
        <mxCell id="entry_click" value="&lt;b&gt;首次手动开启&lt;/b&gt;&lt;br&gt;菜单：下载并开启模型学习" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#AAB5BF;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#17212B;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="400" height="88" as="geometry"/></mxCell>
        <mxCell id="entry_install" value="&lt;b&gt;后台下载、校验、安装&lt;/b&gt;&lt;br&gt;原生 Vulkan 组件，复用本机 Q8 模型" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#AAB5BF;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#17212B;spacing=12;" vertex="1" parent="1"><mxGeometry x="600" y="160" width="400" height="88" as="geometry"/></mxCell>
        <mxCell id="entry_enable" value="&lt;b&gt;安装成功后自动开启&lt;/b&gt;&lt;br&gt;已有兼容组件时直接开启" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#AAB5BF;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#17212B;spacing=12;" vertex="1" parent="1"><mxGeometry x="1140" y="160" width="420" height="88" as="geometry"/></mxCell>
        <mxCell id="entry_a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#687887;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="entry_click" target="entry_install"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="entry_b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#687887;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="entry_install" target="entry_enable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="privacy" value="下载只发生在组件安装时；以下输入、存储、训练与推理均在用户本机完成。" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#687887;" vertex="1" parent="1"><mxGeometry x="60" y="263" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="live" value="01  每次输入与上屏反馈" style="swimlane;html=1;startSize=50;horizontal=1;rounded=0;fillColor=#EAF2FD;swimlaneFillColor=#FFFFFF;strokeColor=#AAC2E0;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=23;fontStyle=1;fontColor=#254F85;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="400" height="1200" as="geometry"/></mxCell>
        <mxCell id="memory" value="02  本地记忆与训练调度" style="swimlane;html=1;startSize=50;horizontal=1;rounded=0;fillColor=#EAF7F0;swimlaneFillColor=#FFFFFF;strokeColor=#9EC9B3;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=23;fontStyle=1;fontColor=#266547;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="600" y="330" width="400" height="1200" as="geometry"/></mxCell>
        <mxCell id="training" value="03  周期训练与适配器生效" style="swimlane;html=1;startSize=50;horizontal=1;rounded=0;fillColor=#FFF4DF;swimlaneFillColor=#FFFFFF;strokeColor=#D6B77C;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=23;fontStyle=1;fontColor=#835915;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="1140" y="330" width="420" height="1200" as="geometry"/></mxCell>
        <mxCell id="input" value="&lt;b&gt;用户输入按键&lt;/b&gt;&lt;br&gt;可选上下文：最近 64 个已上屏字符&lt;br&gt;只取本会话；关闭后不附带" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF5FF;strokeColor=#7D9FCB;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#17212B;spacing=10;" vertex="1" parent="live"><mxGeometry x="40" y="85" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="inference" value="&lt;b&gt;只做一次模型生成&lt;/b&gt;&lt;br&gt;Q8 基座 + 当前个人 LoRA&lt;br&gt;初次开启时尚无个人 LoRA" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF5FF;strokeColor=#7D9FCB;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#17212B;spacing=10;" vertex="1" parent="live"><mxGeometry x="40" y="225" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="candidates" value="&lt;b&gt;候选合并与反馈排序&lt;/b&gt;&lt;br&gt;模型 + 个人词库 + 雾凇&lt;br&gt;保留个人 / 普通候选及翻页&lt;br&gt;频次、近期性、上下文共同排序" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF5FF;strokeColor=#7D9FCB;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#17212B;spacing=10;" vertex="1" parent="live"><mxGeometry x="40" y="385" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="commit" value="&lt;b&gt;用户确认上屏&lt;/b&gt;&lt;br&gt;记录整句与实际选中的片段&lt;br&gt;取消的片段不进入学习" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF5FF;strokeColor=#7D9FCB;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#17212B;spacing=10;" vertex="1" parent="live"><mxGeometry x="40" y="555" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="feedback" value="&lt;b&gt;异步发送上屏反馈&lt;/b&gt;&lt;br&gt;仅在「开启且未暂停」时采集&lt;br&gt;按键、文本、首选、上屏前上下文&lt;br&gt;后台有界队列，不阻塞上屏" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF5FF;strokeColor=#7D9FCB;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#17212B;spacing=10;" vertex="1" parent="live"><mxGeometry x="40" y="715" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="controls" value="&lt;b&gt;学习控制&lt;/b&gt;&lt;br&gt;&lt;br&gt;暂停：停止采集和训练，沿用已有结果&lt;br&gt;关闭：停用个人候选和适配器&lt;br&gt;清空：确认后删除学习数据&lt;br&gt;&lt;br&gt;关闭上下文后，新样本上下文为空。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F7F8;strokeColor=#C5CDD3;dashed=1;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#465564;spacing=14;align=left;" vertex="1" parent="live"><mxGeometry x="30" y="955" width="340" height="185" as="geometry"/></mxCell>
        <mxCell id="criteria" value="&lt;b&gt;新一轮自动训练条件&lt;/b&gt;&lt;br&gt;新上屏记录 ≥ 64 条&lt;br&gt;Beam 输入空闲 ≥ 5 分钟&lt;br&gt;接通电源；距上轮成功 ≥ 4 小时" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4FAF6;strokeColor=#9EC9B3;dashed=1;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#315745;spacing=12;" vertex="1" parent="memory"><mxGeometry x="30" y="85" width="340" height="125" as="geometry"/></mxCell>
        <mxCell id="schedule" value="&lt;b&gt;满足调度条件？&lt;/b&gt;&lt;br&gt;已启用、组件就绪&lt;br&gt;且无活跃组词" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F0F8F3;strokeColor=#72A98D;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#17212B;spacing=6;" vertex="1" parent="memory"><mxGeometry x="50" y="280" width="300" height="155" as="geometry"/></mxCell>
        <mxCell id="wait_note" value="未满足时继续等待；断点任务沿用原快照。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#65756C;" vertex="1" parent="memory"><mxGeometry x="20" y="450" width="360" height="40" as="geometry"/></mxCell>
        <mxCell id="dictionary" value="&lt;b&gt;即时个人词库&lt;/b&gt;&lt;br&gt;&lt;br&gt;原始按键映射&lt;br&gt;全拼 / 简拼 / 混拼&lt;br&gt;词频与纠正偏好" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF8F2;strokeColor=#72A98D;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#17212B;spacing=8;" vertex="1" parent="memory"><mxGeometry x="20" y="545" width="170" height="140" as="geometry"/></mxCell>
        <mxCell id="samples" value="&lt;b&gt;本地样本池&lt;/b&gt;&lt;br&gt;&lt;br&gt;近期 512 个事件&lt;br&gt;回放 4096 个事件&lt;br&gt;长期池蓄水池抽样" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF8F2;strokeColor=#72A98D;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#17212B;spacing=8;" vertex="1" parent="memory"><mxGeometry x="210" y="545" width="170" height="140" as="geometry"/></mxCell>
        <mxCell id="store" value="&lt;b&gt;SQLite 本地学习存储&lt;/b&gt;&lt;br&gt;daemon 唯一写入；事务内事件去重&lt;br&gt;词条、选择统计、样本、学习状态" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#E4F3EA;strokeColor=#72A98D;strokeWidth=1.8;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#17212B;spacing=10;" vertex="1" parent="memory"><mxGeometry x="30" y="720" width="340" height="120" as="geometry"/></mxCell>
        <mxCell id="pause" value="&lt;b&gt;输入优先：可中断、可续训&lt;/b&gt;&lt;br&gt;&lt;br&gt;恢复输入、手动暂停或断开电源&lt;br&gt;完成当前 microbatch 后存档退出&lt;br&gt;释放训练占用的内存&lt;br&gt;再次满足空闲条件时从断点继续" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F7F8;strokeColor=#B5BFC7;dashed=1;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#465564;spacing=12;" vertex="1" parent="memory"><mxGeometry x="30" y="955" width="340" height="185" as="geometry"/></mxCell>
        <mxCell id="snapshot" value="&lt;b&gt;固定训练快照与拼音增强&lt;/b&gt;&lt;br&gt;保留原按键，补全拼 / 简拼变体&lt;br&gt;按事件采样，避免片段重复放大" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFAEF;strokeColor=#C7A366;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#17212B;spacing=10;" vertex="1" parent="training"><mxGeometry x="30" y="85" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="batch" value="&lt;b&gt;混合取样 + 冻结基座教师&lt;/b&gt;&lt;br&gt;8 近期 + 4 历史 + 4 保底&lt;br&gt;保底：通用样本 + 同码普通用法&lt;br&gt;教师缓存：top-32 + 剩余概率" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFAEF;strokeColor=#C7A366;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#17212B;spacing=10;" vertex="1" parent="training"><mxGeometry x="30" y="240" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="train" value="&lt;b&gt;QVAC Vulkan 训练 LoRA r8&lt;/b&gt;&lt;br&gt;冻结 Q8 基座，仅更新线性层适配器&lt;br&gt;每轮 24 步；microbatch 1 梯度累积&lt;br&gt;个人 CE + 0.25 × 保底 CE + 教师 KL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#C7A366;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#17212B;spacing=10;" vertex="1" parent="training"><mxGeometry x="30" y="415" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="export" value="&lt;b&gt;导出独立 GGUF adapter&lt;/b&gt;&lt;br&gt;保存优化器、进度和固定采样计划&lt;br&gt;绑定基座指纹、prompt 和训练配方" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFAEF;strokeColor=#C7A366;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#17212B;spacing=10;" vertex="1" parent="training"><mxGeometry x="30" y="600" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="idle" value="&lt;b&gt;全部组词已结束？&lt;/b&gt;&lt;br&gt;含连接断开后释放" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFAEF;strokeColor=#C7A366;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#17212B;spacing=6;" vertex="1" parent="training"><mxGeometry x="60" y="765" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="activate" value="&lt;b&gt;切换到新适配器&lt;/b&gt;&lt;br&gt;清空 KV、推测草稿与候选缓存&lt;br&gt;后续输入使用新参数&lt;br&gt;保留当前与上一版，支持回退" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#C7A366;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#17212B;spacing=10;" vertex="1" parent="training"><mxGeometry x="30" y="970" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="error_note" value="训练或加载失败：显示错误，当前已生效版本继续使用。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#7C6441;" vertex="1" parent="training"><mxGeometry x="25" y="1120" width="370" height="50" as="geometry"/></mxCell>
        <mxCell id="live_a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6686B0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="live" source="input" target="inference"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="live_b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6686B0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="live" source="inference" target="candidates"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="live_c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6686B0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="live" source="candidates" target="commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="live_d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6686B0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="live" source="commit" target="feedback"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="to_store" value="上屏反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6686B0;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=17;labelBackgroundColor=#FFFFFF;fontColor=#254F85;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="feedback" target="store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="update_words" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5A9576;strokeWidth=2;exitX=0.25;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="memory" source="store" target="dictionary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="update_samples" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5A9576;strokeWidth=2;exitX=0.75;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="memory" source="store" target="samples"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="recall" value="下一次立即召回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#397B58;strokeWidth=2.5;fontFamily=Noto Sans CJK SC;fontSize=17;labelBackgroundColor=#FFFFFF;fontColor=#266547;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="dictionary" target="candidates"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="515" y="945"/><mxPoint x="515" y="775"/></Array></mxGeometry></mxCell>
        <mxCell id="sample_schedule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5A9576;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.75;entryY=0.75;" edge="1" parent="memory" source="samples" target="schedule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="criteria_gate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#8EB59E;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="memory" source="criteria" target="schedule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="train_start" value="是：开始 / 续跑" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5A9576;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=17;labelBackgroundColor=#FFFFFF;fontColor=#266547;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="schedule" target="snapshot"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="687.5"/><mxPoint x="1060" y="467.5"/></Array></mxGeometry></mxCell>
        <mxCell id="train_a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B68C48;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="training" source="snapshot" target="batch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="train_b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B68C48;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="training" source="batch" target="train"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="train_c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B68C48;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="training" source="train" target="export"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="train_d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B68C48;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="training" source="export" target="idle"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="train_e" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B68C48;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=17;labelBackgroundColor=#FFFFFF;fontColor=#835915;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="training" source="idle" target="activate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wait_idle" value="否：等待" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B68C48;strokeWidth=1.5;dashed=1;fontFamily=Noto Sans CJK SC;fontSize=16;labelBackgroundColor=#FFFFFF;fontColor=#835915;exitX=1;exitY=0.5;entryX=1;entryY=0.15;" edge="1" parent="training" source="idle" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="835"/><mxPoint x="405" y="790"/></Array></mxGeometry></mxCell>
        <mxCell id="training_pause" value="输入恢复等中断事件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#85909A;strokeWidth=1.5;dashed=1;fontFamily=Noto Sans CJK SC;fontSize=16;labelBackgroundColor=#FFFFFF;fontColor=#65717C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="train" target="pause"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="807.5"/><mxPoint x="1080" y="1377.5"/></Array></mxGeometry></mxCell>
