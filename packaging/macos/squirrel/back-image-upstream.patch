+#   # nine-slice in image points: the corners keep their size, the edges and the center stretch
+#   back_image_slice: { left: 40, right: 40, top: 20, bottom: 20 }
+#   # room between the window edge and the panel, where only the image shows
+#   back_image_padding: { left: 30, right: 60, top: 20, bottom: 20 }
